' Handshake when node A dials node B, in the two link shapes.
' Rendered by make_handshake.sh into ../tex/figures/handshake_{simplex,duplex}.pdf

@startuml handshake_simplex
!pragma teoz true
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Serif
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
hide footbox
title Simplex: two connections
participant A
participant B
A -> B : TCP connect (conn 1)
A -> B : Connect{X, endpoints}
note over B : rx := conn 1\nsender dials A back\n(tx := conn 2)
B -> A : TCP connect (conn 2)
B -> A : ConnectAck{Y, X}
note over A : rx := conn 2\n(tx := conn 1)
note over A, B : both sides ready after ~3 RTT
@enduml

@startuml handshake_duplex
!pragma teoz true
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Serif
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
hide footbox
title Duplex: one connection
participant A
participant B
A -> B : TCP connect (conn)
A -> B : Connect{X}
note over B : rx := tx := conn
B -> A : ConnectAck{Y, X}\n(same connection)
note over A : rx := tx := conn
note over A, B : both sides ready after ~2 RTT
@enduml
